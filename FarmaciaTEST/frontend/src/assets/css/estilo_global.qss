
QWidget {
    background-color: #f5f6fa;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 14px;
}

QPushButton {
    background-color: #2c3e50;
    color: white;
    border-radius: 5px;
    padding: 8px 16px;
}

QPushButton:hover {
    background-color: #34495e;
}

QLineEdit {
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 6px;
    background-color: white;
}
